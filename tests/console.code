| The console driven the way the window drives it, on a window of its own
| that draws into memory (`headless`): a shell in its one terminal, typed
| into, its output drawn; scrolling back (and the scroll keys left to a
| program on the alternate screen), a selection, keys from
| keybindings.json, settings checked, the terminal's end closing it.

link "../src/app.gene.code"
link "../src/keys.gene.code"
link "../src/render.gene.code"
link "../src/settings.gene.code"

| The window and strings organelles, and the window, once there are.
window_lib = null
strings_lib = null
window_id = 0

| Whether `part` is somewhere in `text`.
Contains { text, part } =>
    emit Length { value = text } to core get { value as size }
    emit Length { value = part } to core get { value as want }
    i = 0
    loop
        if i + want > size, break
        if text[i, i + want) = part, return Is { yes = true }
        i += 1
    return Is { yes = false }

| The window's rows, as one text.
Drawn {} =>
    emit Render to this
    emit Text { id = window_id } to window_lib get shown
    emit Join { value = shown.rows, separator = "\n" } to strings_lib get joined
    return Text { text = joined.value }

| Waits (at most `seconds`) until the window shows `part`; whether it did.
WaitFor { part, seconds } =>
    emit Timestamp {} to core get started
    loop
        emit Drawn to this get now
        emit Contains { text = now.text, part = part } to this get found
        if found.yes, return Is { yes = true }
        emit Timestamp {} to core get later
        if later.value - started.value > seconds, return Is { yes = false }

emit UseOrganelles { from = "organelles" } to this get lib
assert lib ∈ Linked
window_lib = lib.window
strings_lib = lib.strings
shells_lib = lib.pty
config_lib = lib.fs
emit SettingsAt { dir = ".test-config" } to this get first_settings
assert first_settings.values["font.size"] = 15 and first_settings.values["split.size"] = null
emit Setting { key = "terminal.shell", value = "/bin/sh" } to this

emit Open { headless = true, cols = 60, rows = 12 } to window_lib get opened
assert opened ∈ WindowOpened
window_id = opened.id
emit Attach { window = opened.id, cols = opened.cols, rows = opened.rows } to this

| A shell, typed into: its output is drawn.
emit NewTerminal {} to this get made
assert made ∈ Opened
emit HandleKey { name = "e", text = "e" } to this
loop ch over ["c", "h", "o", " ", "h", "i", "-", "t", "h", "e", "r", "e"]
    emit HandleKey { name = ch, text = ch } to this
emit HandleKey { name = "enter", text = "" } to this
emit WaitFor { part = "\nhi-there", seconds = 5 } to this get echoed
assert echoed.yes

| No tabs, no splits: their keys reach the program.
emit State to this get one_terminal
assert one_terminal.term.id = made.id
emit ReadBindings { text = null } to this get defaults_only
assert defaults_only.keys["ctrl+shift+t"] = null and defaults_only.keys["ctrl+shift+d"] = null and defaults_only.keys["ctrl+shift+left"] = null

| Scrolling back: lines printed, a page up shows older ones and says so.
loop ch over ["s", "e", "q", " ", "1", " ", "4", "0"]
    emit HandleKey { name = ch, text = ch } to this
emit HandleKey { name = "enter", text = "" } to this
emit WaitFor { part = "\n40 ", seconds = 5 } to this get counted
assert counted.yes
emit HandleKey { name = "shift+pageup", text = "" } to this
emit Drawn to this get scrolled
emit Contains { text = scrolled.text, part = "lines back" } to this get marked
assert marked.yes
| A key goes to the shell, and brings the live screen back.
emit HandleKey { name = "space", text = " " } to this
emit Drawn to this get live
emit Contains { text = live.text, part = "lines back" } to this get still_marked
assert not still_marked.yes

| A program on the alternate screen (an editor, the ide) has no
| scrollback: the scroll keys go to it.
loop ch over ["p", "r", "i", "n", "t", "f", " ", "'", "\\", "0", "3", "3", "[", "?", "1", "0", "4", "9", "h", "'"]
    emit HandleKey { name = ch, text = ch } to this
emit HandleKey { name = "enter", text = "" } to this
emit Timestamp {} to core get alt_at
on_alternate = false
loop
    emit Drawn to this
    emit ScreenOf to this get alt_try
    if alt_try.screen ≠ null and alt_try.screen.alternate = true
        on_alternate = true
        break
    emit Timestamp {} to core get alt_now
    if alt_now.value - alt_at.value > 5, break
assert on_alternate
emit HandleKey { name = "ctrl+shift+up", text = "" } to this get passed
assert passed ∈ Typed
emit HandleKey { name = "shift+pageup", text = "" } to this get passed_page
assert passed_page ∈ Typed
loop ch over ["p", "r", "i", "n", "t", "f", " ", "'", "\\", "0", "3", "3", "[", "?", "1", "0", "4", "9", "l", "'"]
    emit HandleKey { name = ch, text = ch } to this
emit HandleKey { name = "enter", text = "" } to this

| A selection, made with the mouse, is the text under it.
tid = made.id
emit Render to this
emit Hit { row = 2, col = 5 } to this get at_cell
assert at_cell.at ≠ null
emit Hit { row = 50, col = 5 } to this get outside
assert outside.at = null
emit ScreenOf to this get last_screen
emit SelectedText { screen = last_screen.screen, selection = { anchor = { row = 0, col = 0 }, head = { row = 0, col = 200 } } } to this get picked
assert picked.text ≠ ""

| Ctrl+Shift+= / - / 0: the letters bigger, smaller, back.
emit HandleKey { name = "ctrl+shift+=", text = "" } to this
emit HandleKey { name = "ctrl+shift+=", text = "" } to this
emit State to this get bigger
assert bigger.font_px = 17
emit HandleKey { name = "ctrl+shift+-", text = "" } to this
emit State to this get smaller
assert smaller.font_px = 16
emit HandleKey { name = "ctrl+shift+0", text = "" } to this
emit State to this get reset
assert reset.font_px = 15

| keybindings.json: a key of the user's runs its command; a default taken away.
emit ReadBindings { text = "[{ \"key\": \"ctrl+alt+c\", \"command\": \"edit.copy\" }, { \"key\": \"ctrl+shift+c\", \"command\": \"-edit.copy\" }]" } to this get mine
assert mine.keys["ctrl+alt+c"] = "edit.copy" and mine.keys["ctrl+shift+c"] = null
assert mine.keys["ctrl+tab"] = null
emit ReadBindings { text = "[{ \"key\": \"ctrl+shift+t\", \"command\": \"tab.new\" }]" } to this get old_command
assert old_command.problem = "keybindings.json: entry 1: no command \"tab.new\""
| Settings: a bad value falls back, and says which.
emit ReadSettings { text = "{ \"font.size\": 2, \"split.size\": 30 }" } to this get checked
assert checked.values["font.size"] = 15 and checked.values["split.size"] = null
assert checked.problem = "settings.json: using the default for font.size (6 to 96)"

| `console -e program`: the terminal runs a program, not the shell, and
| is called after it.
emit NewTerminal { run = "printf 'ran-%s\\n' \$((40 + 2)); sleep 5", title = "demo" } to this get ran
assert ran ∈ Opened
emit Close { id = tid } to shells_lib
emit WaitFor { part = "ran-42", seconds = 5 } to this get ran_shown
assert ran_shown.yes
emit State to this get ran_state
assert ran_state.term.label = "demo"

| The terminal's program ends: the console closes.
emit TerminalExited { id = tid, code = 0 } to this get not_ours
assert not_ours ∈ Nothing
emit TerminalExited { id = ran.id, code = 0 } to this get ended
assert ended ∈ Closed
emit Close { id = ran.id } to shells_lib
emit RemoveDir { path = "." } to config_lib
