| app — the console's state, and what each event does to it.
|
| The one gene that holds state: a gene's top level is its handlers' whole
| world, so everything that changes lives here and the others answer
| particles (keys, settings, render).
|
| The console is a window of its own (the `window` organelle) with one
| terminal in it (the `pty` organelle) — no tabs, no splits: another
| terminal is another console. A key arrives whole from the window (ctrl+tab
| is not tab) as `Key { id, name, text }`: a bound command runs
| (keys.gene.code — Ctrl+Shift+… by default), anything else goes to the
| terminal, which passes it on the way its program asked for keys. Then the
| window is drawn again.

| The window, and its size in cells.
wid = 0
cols = 110
rows = 32
running = false

| The terminal: `{ id, label }` — its label what its program calls
| itself — or null before it opens.
term = null
| How far back it is scrolled, and the size it was last told.
scroll = 0
size_told = ""
| What it showed last (for copying a selection, and to know whether its
| program is on the alternate screen).
last_screen = null
| A selection being made or made: `{ id, anchor, head, dragging }`, cells in the
| terminal's body.
selection = null
chord = ""

| Where the console was started: new terminals begin there.
start_dir = ""

| The organelles (linked while it runs: see `Organelles`).
win = null
shells = null
prefs = null
vars = null
texts = null

settings ∈ Object of (Number ∪ String ∪ Boolean) = null
settings_dir = ""
| The letters' size now (Ctrl+Shift+= / -), in pixels; 0 until the window
| opens at settings' font.size.
font_px = 0
keytable = null
message = ""

| Links the organelles from the folder `from`: `.` in a release bundle
| (bin/console starts it there), `organelles` in a checkout.
Organelles { from } =>
    link from + "/window.so" as window_at
    link from + "/pty.so" as pty_at
    link from + "/fs.so" as fs_at
    link from + "/json.so" as json_at
    link from + "/strings.so" as strings_at
    link from + "/env.so" as env_at
    return Linked { window = window_at, pty = pty_at, fs = fs_at, json = json_at, strings = strings_at, env = env_at }

UseOrganelles { from } =>
    emit Organelles { from = from } to this get linked
    if linked ∈ Exception, return linked
    win = linked.window
    shells = linked.pty
    prefs = linked.fs
    vars = linked.env
    texts = linked.strings
    emit SettingsUses { json = linked.json } to this
    emit KeysUses { json = linked.json, strings = linked.strings } to this
    emit RenderUses { strings = linked.strings } to this
    return linked

EuglenaHasBeenBorn { cell_name } =>
    emit UseOrganelles { from = "." } to this get bundled
    if bundled ∈ Exception
        emit UseOrganelles { from = "organelles" } to this get checkout
        if checkout ∈ Exception, return Failed { reason = "the organelles could not be linked: " + checkout.message }
    emit Get { name = "CONSOLE_DIR", default = "" } to vars get chosen
    emit Get { name = "HOME", default = "/" } to vars get home
    start_dir = chosen.value
    if start_dir = "", start_dir = home.value
    | `console -e program …` (bin/console): the first terminal runs that
    | instead of the shell, and is called after it.
    emit Get { name = "CONSOLE_RUN", default = "" } to vars get run_given
    emit Get { name = "CONSOLE_TITLE", default = "" } to vars get title_given
    emit Get { name = "XDG_CONFIG_HOME", default = "" } to vars get xdg
    config = xdg.value
    if config = "", config = home.value + "/.config"
    emit SettingsAt { dir = config + "/codelovesme-console" } to this
    request = Open { title = "console", cols = settings["window.cols"], rows = settings["window.rows"], font_size = settings["font.size"] }
    if settings["font.family"] ≠ "", request = request + { font = settings["font.family"] }
    if settings["font.bold"] ≠ "", request = request + { bold_font = settings["font.bold"] }
    emit request to win get opened
    if opened ∈ Exception, return Failed { reason = opened.message }
    wid = opened.id
    font_px = settings["font.size"]
    cols = opened.cols
    rows = opened.rows
    running = true
    emit NewTerminal { run = run_given.value, title = title_given.value } to this get first
    if first ∈ Failed, return first
    emit Render to this
    return Alive { cell_name = cell_name }

| A window made elsewhere, `cols` × `rows`, drawn on from now on (the
| tests give one that draws into memory).
Attach { window, cols as width, rows as height } =>
    wid = window
    cols = width
    rows = height
    running = true
    return Attached

| One setting changed for this run.
Setting { key, value } =>
    settings = settings + { "$key" = value }
    return Set

| What the terminal showed last.
ScreenOf =>
    return Shown { screen = last_screen }

| ── From the window ────────────────────────────────────────────────────

Key { id, name, text, event } =>
    if not running, return Ignored
    message = ""
    emit HandleKey { name = name, text = text, event = event } to this get handled
    emit Render to this
    return handled

KeyReleased { name } =>
    if running and term ≠ null, emit Type { id = term.id, name = name, text = "", event = "release" } to shells
    return Noted

Resize { id, cols as width, rows as height } =>
    cols = width
    rows = height
    emit Render to this
    return Resized

CloseRequested { id } =>
    emit Quit to this
    return Closing

Focus { id, focused } =>
    | End a held shortcut if the window loses the keyboard before key-up.
    if not focused and running and term ≠ null, emit Type { id = term.id, name = "left_control", text = "", event = "release" } to shells
    return Noted

Mouse { id, kind, button, row, col, mods } =>
    if not running, return Ignored
    emit HandleMouse { kind = kind, button = button, row = row, col = col } to this get handled
    emit Render to this
    return handled

| ── From the terminals ─────────────────────────────────────────────────

TerminalOutput { id } =>
    if running, emit Render to this
    return Drawn

| The terminal's program ended: the console closes with it.
TerminalExited { id, code } =>
    if term = null or id ≠ term.id, return Nothing
    emit Quit to this
    return Closed

| ── Keys ───────────────────────────────────────────────────────────────

| A bound command runs; any other key goes to the terminal, which is
| brought back to its live screen. A program on the alternate screen (an
| editor, the ide) has no scrollback: the scroll keys are its own.
HandleKey { name, text, event } =>
    emit Keymap { name = name, pending = chord, table = keytable } to this get bound
    chord = bound.pending
    if chord ≠ "", return Waiting
    command = bound.command
    if command ≠ null and command[0, 7) = "scroll." and last_screen ≠ null and last_screen.alternate = true, command = null
    if command ≠ null
        emit Run { command = command } to this
        return Ran
    if term = null, return Nothing
    scroll = 0
    selection = null
    emit Type { id = term.id, name = name, text = text, event = event } to shells
    return Typed

| A command, from a key.
Run { command } =>
    if command = "edit.copy", emit CopySelection to this
    if command = "edit.paste" and term ≠ null
        emit Paste {} to win get clip
        if clip ∉ Exception and clip.text ≠ "", emit Paste { id = term.id, text = clip.text } to shells
    if command[0, 7) = "scroll.", emit ScrollBy { command = command } to this
    if command = "font.bigger" or command = "font.smaller" or command = "font.reset"
        if font_px = 0, font_px = settings["font.size"]
        px = font_px
        if command = "font.bigger", px = px + 1
        if command = "font.smaller", px = px - 1
        if command = "font.reset", px = settings["font.size"]
        if px < 6, px = 6
        if px > 96, px = 96
        emit Font { id = wid, size = px } to win get sized
        if sized ∉ Exception, font_px = px
    if command = "app.quit", emit Quit to this
    return Ran

| The terminal scrolled back or forward (the command says how far).
ScrollBy { command } =>
    at = scroll
    page = rows - 2
    if page < 1, page = 1
    if command = "scroll.pageUp", at += page
    if command = "scroll.pageDown", at = at - page
    if command = "scroll.lineUp", at += 1
    if command = "scroll.lineDown", at = at - 1
    if command = "scroll.top", at = 1000000
    if command = "scroll.bottom", at = 0
    if at < 0, at = 0
    scroll = at
    return Scrolled

| The terminal, running the shell (settings: terminal.shell) in the folder
| the console started in — or, when `run` is given (a shell command line),
| running that, called `title`.
NewTerminal { run, title } =>
    request = Open { cols = cols, rows = rows, cwd = start_dir, scrollback = settings["terminal.scrollback"] }
    shell = settings["terminal.shell"]
    if shell ≠ "", request = request + { command = shell }
    runs = run ∈ String
    if runs, runs = run ≠ ""
    if runs, request = request + { command = "/bin/sh", args = ["-c", run] }
    emit request to shells get opened
    if opened ∈ Exception
        message = "a terminal could not be opened: " + opened.message
        return Failed { reason = message }
    label = "Terminal"
    if runs and title ∈ String and title ≠ "", label = title
    term = { id = opened.id, label = label }
    scroll = 0
    size_told = ""
    return Opened { id = opened.id }

Quit =>
    running = false
    if term ≠ null, emit Close { id = term.id } to shells
    emit Close { id = wid } to win
    return Quitting

| ── The mouse ──────────────────────────────────────────────────────────

| Where (`row`, `col`) is in the terminal: the cell, or null outside it.
Hit { row, col } =>
    if row < 0 or col < 0 or row ≥ rows or col ≥ cols, return Hit { at = null }
    return Hit { at = { row = row, col = col } }

| In a terminal whose program asked for the mouse, the mouse goes to it;
| otherwise the wheel scrolls back and a drag selects (and copies, on
| release).
HandleMouse { kind, button, row, col } =>
    if term = null, return Nothing
    emit Hit { row = row, col = col } to this get hit
    if selection ≠ null and selection.dragging and kind = "drag" and hit.at ≠ null
        selection = selection + { head = hit.at }
        return Selecting
    if selection ≠ null and selection.dragging and kind = "release"
        selection = selection + { dragging = false }
        if selection.anchor = selection.head
            selection = null
            return Clicked
        emit CopySelection to this
        return Selected
    if hit.at = null, return Nothing
    wants = last_screen ≠ null and last_screen.mouse ≠ "none" and last_screen.scrolled = 0
    if wants
        emit Mouse { id = term.id, kind = kind, button = button, row = hit.at.row, col = hit.at.col } to shells
        return Sent
    if kind = "wheel"
        command = "scroll.lineUp"
        if button = 1, command = "scroll.lineDown"
        loop n over [1, 2, 3]
            emit ScrollBy { command = command } to this
        return Scrolled
    if kind = "press" and button = 0
        selection = { anchor = hit.at, head = hit.at, dragging = true }
        return Selecting
    return Nothing

| The selection's text onto the desktop's clipboard.
CopySelection =>
    if selection = null or last_screen = null, return Nothing
    emit SelectedText { screen = last_screen, selection = selection } to this get chosen
    if chosen.text = "", return Nothing
    emit Copy { text = chosen.text } to win get copied
    if copied ∈ Exception, message = "Copy: " + copied.message
    return Copied

| ── Settings and keys ──────────────────────────────────────────────────

SettingsAt { dir } =>
    emit Config { base_path = dir } to prefs get configured
    if configured ∈ Exception
        message = "settings: " + configured.message
        settings_dir = dir
    if configured ∉ Exception, settings_dir = configured.base_path
    emit LoadKeybindings to this
    emit LoadSettings to this get loaded
    return loaded

LoadKeybindings =>
    emit Exists { path = "keybindings.json" } to prefs get there
    text = null
    if there ∉ Exception and there.is_file
        emit ReadFile { path = "keybindings.json" } to prefs get read
        if read ∉ Exception, text = read.content
    emit ReadBindings { text = text } to this get table
    keytable = table
    if table.problem ≠ "", message = table.problem
    return table

LoadSettings =>
    emit Exists { path = "settings.json" } to prefs get there
    text = null
    if there ∉ Exception and there.is_file
        emit ReadFile { path = "settings.json" } to prefs get read
        if read ∉ Exception, text = read.content
    emit ReadSettings { text = text } to this get read_back
    settings = read_back.values
    if read_back.problem ≠ "", message = read_back.problem
    return read_back

| ── Drawing ────────────────────────────────────────────────────────────

State =>
    return ConsoleState { term = term, cols = cols, rows = rows, settings = settings, selection = selection, message = message, font_px = font_px, scroll = scroll }

| The terminal: told the window's size when that changed, and read as far
| back as it is scrolled.
ReadScreen =>
    if term = null, return ScreenRead { screen = null }
    size = "" + cols + "x" + rows
    if size_told ≠ size and cols > 0 and rows > 0
        emit Resize { id = term.id, cols = cols, rows = rows } to shells
        size_told = size
    emit Screen { id = term.id, scroll = scroll } to shells get screen
    if screen ∈ Exception, return ScreenRead { screen = null }
    | Scrolled no further than there was.
    scroll = screen.scrolled
    return ScreenRead { screen = screen }

Render =>
    if not running, return Skipped
    emit ReadScreen to this get read
    if read.screen ≠ null
        last_screen = read.screen
        | Called after what its program calls itself.
        if read.screen.title ≠ "", term = term + { label = read.screen.title }
    emit State to this get state
    emit Frame { state = state, screen = read.screen } to this get frame
    emit Draw { id = wid, overlays = frame.overlays, cursor_row = frame.cursor_row, cursor_col = frame.cursor_col } to win
    title = "console"
    if term ≠ null, title = term.label + " — console"
    emit Title { id = wid, text = title } to win
    return Rendered
