| app — the console's state, and what each event does to it.
|
| The one gene that holds state: a gene's top level is its handlers' whole
| world, so everything that changes lives here and the others answer
| particles (keys, layout, tabs, settings, render).
|
| The console is a window of its own (the `window` organelle) full of
| terminals (the `pty` organelle): tabs, in groups, each group in a slot of
| the layout — the ide's model, where everything is a tab. A key arrives
| whole from the window (ctrl+tab is not tab) as `Key { id, name, text }`:
| a bound command runs (keys.gene.code — Ctrl+Shift+… by default), anything
| else goes to the terminal with the keys, which passes it on the way its
| program asked for keys. Then the window is drawn again.

| The window, and its size in cells.
wid = 0
cols = 110
rows = 32
running = false

| The terminals: tabs (`{ kind = "terminal", path, store, id, label }`) in
| groups (see tabs.gene.code), and the group with the keys.
groups = []
current = 0
opened_count = 0
| How far back each terminal is scrolled, and the size each was last told.
scrolls = {}
sizes_told = {}
| What each terminal showed last (for copying a selection), and where each
| group is on screen (for the mouse).
screens = {}
places = []
| A selection being made or made: `{ id, anchor, head, dragging }`, cells in the
| terminal's body.
selection = null
chord = ""

| Where the console was started: new terminals begin there.
start_dir = ""

| The organelles (linked while it runs: see `Organelles`).
win = null
shells = null
prefs = null
vars = null
texts = null

settings = null
settings_dir = ""
| The letters' size now (Ctrl+Shift+= / -), in pixels; 0 until the window
| opens at settings' font.size.
font_px = 0
keytable = null
message = ""

| Links the organelles from the folder `from`: `.` in a release bundle
| (bin/console starts it there), `organelles` in a checkout.
Organelles { from } =>
    link from + "/window.so" as window_at
    link from + "/pty.so" as pty_at
    link from + "/fs.so" as fs_at
    link from + "/json.so" as json_at
    link from + "/strings.so" as strings_at
    link from + "/env.so" as env_at
    return Linked { window = window_at, pty = pty_at, fs = fs_at, json = json_at, strings = strings_at, env = env_at }

UseOrganelles { from } =>
    emit Organelles { from = from } to this get linked
    if linked ∈ Exception, return linked
    win = linked.window
    shells = linked.pty
    prefs = linked.fs
    vars = linked.env
    texts = linked.strings
    emit SettingsUses { json = linked.json } to this
    emit KeysUses { json = linked.json, strings = linked.strings } to this
    emit RenderUses { strings = linked.strings } to this
    return linked

EuglenaHasBeenBorn { cell_name } =>
    emit UseOrganelles { from = "." } to this get bundled
    if bundled ∈ Exception
        emit UseOrganelles { from = "organelles" } to this get checkout
        if checkout ∈ Exception, return Failed { reason = "the organelles could not be linked: " + checkout.message }
    emit Get { name = "CONSOLE_DIR", default = "" } to vars get chosen
    emit Get { name = "HOME", default = "/" } to vars get home
    start_dir = chosen.value
    if start_dir = "", start_dir = home.value
    emit Get { name = "XDG_CONFIG_HOME", default = "" } to vars get xdg
    config = xdg.value
    if config = "", config = home.value + "/.config"
    emit SettingsAt { dir = config + "/codelovesme-console" } to this
    request = Open { title = "console", cols = settings["window.cols"], rows = settings["window.rows"], font_size = settings["font.size"] }
    if settings["font.family"] ≠ "", request = request + { font = settings["font.family"] }
    if settings["font.bold"] ≠ "", request = request + { bold_font = settings["font.bold"] }
    emit request to win get opened
    if opened ∈ Exception, return Failed { reason = opened.message }
    wid = opened.id
    font_px = settings["font.size"]
    cols = opened.cols
    rows = opened.rows
    running = true
    emit NewTerminal { slot = "c" } to this get first
    if first ∈ Failed, return first
    emit Render to this
    return Alive { cell_name = cell_name }

| A window made elsewhere, `cols` × `rows`, drawn on from now on (the
| tests give one that draws into memory).
Attach { window, cols as width, rows as height } =>
    wid = window
    cols = width
    rows = height
    running = true
    return Attached

| One setting changed for this run.
Setting { key, value } =>
    settings = settings + { "$key" = value }
    return Set

| What terminal `id` showed last.
ScreenOf { id } =>
    return Shown { screen = screens["$id"] }

| ── From the window ────────────────────────────────────────────────────

Key { id, name, text } =>
    if not running, return Ignored
    message = ""
    emit HandleKey { name = name, text = text } to this get handled
    emit Render to this
    return handled

Resize { id, cols as width, rows as height } =>
    cols = width
    rows = height
    emit Render to this
    return Resized

CloseRequested { id } =>
    emit Quit to this
    return Closing

Focus { id, focused } =>
    return Noted

Mouse { id, kind, button, row, col, mods } =>
    if not running, return Ignored
    emit HandleMouse { kind = kind, button = button, row = row, col = col } to this get handled
    emit Render to this
    return handled

| ── From the terminals ─────────────────────────────────────────────────

TerminalOutput { id } =>
    if running, emit Render to this
    return Drawn

| A terminal's program ended: its tab closes; the last one closes the
| console. The tab that edited settings.json has them read again.
TerminalExited { id, code } =>
    emit FindTerminal { id = id } to this get where
    if where.group < 0, return Nothing
    view = groups[where.group].tabs[where.tab]
    emit CloseAt { groups = groups, current = current, group = where.group, tab = where.tab } to this get closed
    groups = closed.groups
    current = closed.current
    if view.settings = true
        emit LoadSettings to this
        emit LoadKeybindings to this
    emit Length { value = groups } to core get { value as left }
    if left = 0
        emit Quit to this
        return Closed
    if running, emit Render to this
    return Closed

FindTerminal { id } =>
    loop gi, group over groups
        loop ti, tab over group.tabs
            if tab.id = id, return Place { group = gi, tab = ti }
    return Place { group = -1, tab = -1 }

| ── Keys ───────────────────────────────────────────────────────────────

| A bound command runs; any other key goes to the terminal with the keys,
| which is brought back to its live screen.
HandleKey { name, text } =>
    emit Keymap { name = name, pending = chord, table = keytable } to this get bound
    chord = bound.pending
    if chord ≠ "", return Waiting
    if bound.command ≠ null
        emit Run { command = bound.command } to this
        return Ran
    emit Active { groups = groups, current = current } to this get shown
    if shown.buffer = null, return Nothing
    tid = shown.buffer.id
    scrolls = scrolls + { "$tid" = 0 }
    selection = null
    emit Type { id = tid, name = name, text = text } to shells
    return Typed

| A command, from a key.
Run { command } =>
    emit Active { groups = groups, current = current } to this get shown
    tid = -1
    if shown.buffer ≠ null, tid = shown.buffer.id
    if command = "tab.new"
        slot = "c"
        if groups[current] ≠ null, slot = groups[current].slot
        emit NewTerminal { slot = slot } to this
    if command = "split.right", emit NewTerminal { slot = "r" } to this
    if command = "split.down", emit NewTerminal { slot = "b" } to this
    if command = "tab.close" and tid ≥ 0, emit Close { id = tid } to shells
    if command = "tab.next" or command = "tab.previous"
        step = 1
        if command = "tab.previous", step = -1
        emit StepTab { groups = groups, current = current, step = step } to this get stepped
        groups = stepped.groups
    if command = "focus.next" or command = "focus.previous"
        emit Length { value = groups } to core get { value as count }
        if count > 0
            next = current + 1
            if command = "focus.previous", next = current - 1
            if next ≥ count, next = 0
            if next < 0, next = count - 1
            current = next
    if command = "edit.copy", emit CopySelection to this
    if command = "edit.paste" and tid ≥ 0
        emit Paste {} to win get clip
        if clip ∉ Exception and clip.text ≠ "", emit Paste { id = tid, text = clip.text } to shells
    if command[0, 7) = "scroll." and tid ≥ 0, emit ScrollBy { id = tid, command = command } to this
    if command = "font.bigger" or command = "font.smaller" or command = "font.reset"
        if font_px = 0, font_px = settings["font.size"]
        px = font_px
        if command = "font.bigger", px = px + 1
        if command = "font.smaller", px = px - 1
        if command = "font.reset", px = settings["font.size"]
        if px < 6, px = 6
        if px > 96, px = 96
        emit Font { id = wid, size = px } to win get sized
        if sized ∉ Exception, font_px = px
    if command = "settings.open", emit EditSettings to this
    if command = "app.quit", emit Quit to this
    return Ran

| The terminal `id` scrolled back or forward (the command says how far).
ScrollBy { id, command } =>
    at = scrolls["$id"]
    if at = null, at = 0
    page = rows - 2
    if page < 1, page = 1
    if command = "scroll.pageUp", at += page
    if command = "scroll.pageDown", at = at - page
    if command = "scroll.lineUp", at += 1
    if command = "scroll.lineDown", at = at - 1
    if command = "scroll.top", at = 1000000
    if command = "scroll.bottom", at = 0
    if at < 0, at = 0
    scrolls = scrolls + { "$id" = at }
    return Scrolled

| A new terminal, running the shell (settings: terminal.shell) in the
| folder the console started in, as a tab in the group in `slot`.
NewTerminal { slot } =>
    request = Open { cols = 80, rows = 24, cwd = start_dir, scrollback = settings["terminal.scrollback"] }
    shell = settings["terminal.shell"]
    if shell ≠ "", request = request + { command = shell }
    emit request to shells get opened
    if opened ∈ Exception
        message = "a terminal could not be opened: " + opened.message
        return Failed { reason = message }
    opened_count += 1
    view = { kind = "terminal", path = "Terminal " + opened_count, store = "terminal", id = opened.id, label = "Terminal " + opened_count }
    emit OpenIn { groups = groups, slot = slot, buffer = view } to this get placed
    groups = placed.groups
    current = placed.current
    return Opened { id = opened.id }

| settings.json, in the editor $EDITOR names (else `vi`), as a tab; when
| it closes the settings are read again.
EditSettings =>
    emit Exists { path = "settings.json" } to prefs get there
    if there ∉ Exception and not there.is_file
        emit WriteSettings { values = settings } to this get written
        emit WriteFile { path = "settings.json", content = written.text } to prefs
    emit Get { name = "EDITOR", default = "vi" } to vars get editor
    program = editor.value
    if program = "", program = "vi"
    emit Open { cols = 80, rows = 24, cwd = settings_dir, command = program, args = [settings_dir + "/settings.json"] } to shells get opened
    if opened ∈ Exception
        message = program + " could not be started: " + opened.message
        return Failed
    view = { kind = "terminal", path = "settings.json", store = "settings", id = opened.id, label = "settings.json", settings = true }
    slot = "c"
    if groups[current] ≠ null, slot = groups[current].slot
    emit OpenIn { groups = groups, slot = slot, buffer = view } to this get placed
    groups = placed.groups
    current = placed.current
    return Opened

Quit =>
    running = false
    loop group over groups
        loop tab over group.tabs
            emit Close { id = tab.id } to shells
    emit Close { id = wid } to win
    return Quitting

| ── The mouse ──────────────────────────────────────────────────────────

| Where (`row`, `col`) is: the group, and whether on its tab strip (`tab`,
| the tab clicked, or -1) or in its terminal (`at`, the cell in it).
Hit { row, col } =>
    loop place over places
        b = place.body
        inside = col ≥ b.x and col < b.x + b.width
        if inside and row = place.tab_row and row < b.y
            loop hit over place.hits
                if col ≥ hit.from and col < hit.until, return Hit { group = place.group, tab = hit.tab, at = null, id = place.id }
            return Hit { group = place.group, tab = -1, at = null, id = place.id }
        if inside and row ≥ b.y and row < b.y + b.height
            return Hit { group = place.group, tab = -1, at = { row = row - b.y, col = col - b.x }, id = place.id }
    return Hit { group = -1, tab = -1, at = null, id = -1 }

| A click on a tab shows it; in a terminal whose program asked for the
| mouse, the mouse goes to it; otherwise the wheel scrolls back and a drag
| selects (and copies, on release).
HandleMouse { kind, button, row, col } =>
    emit Hit { row = row, col = col } to this get hit
    if selection ≠ null and selection.dragging and kind = "drag" and hit.id = selection.id and hit.at ≠ null
        selection = selection + { head = hit.at }
        return Selecting
    if selection ≠ null and selection.dragging and kind = "release"
        selection = selection + { dragging = false }
        if selection.anchor = selection.head
            selection = null
            return Clicked
        emit CopySelection to this
        return Selected
    if hit.group < 0, return Nothing
    if kind = "press" and hit.tab ≥ 0
        held = groups[hit.group] + { active = hit.tab }
        groups = groups[0, hit.group) + [held] + groups(hit.group, length)
        current = hit.group
        return Shown
    if hit.at = null, return Nothing
    if kind = "press", current = hit.group
    screen = screens["$hit.id"]
    wants = screen ≠ null and screen.mouse ≠ "none" and screen.scrolled = 0
    if wants
        emit Mouse { id = hit.id, kind = kind, button = button, row = hit.at.row, col = hit.at.col } to shells
        return Sent
    if kind = "wheel"
        command = "scroll.lineUp"
        if button = 1, command = "scroll.lineDown"
        emit ScrollBy { id = hit.id, command = command } to this
        emit ScrollBy { id = hit.id, command = command } to this
        emit ScrollBy { id = hit.id, command = command } to this
        return Scrolled
    if kind = "press" and button = 0
        selection = { id = hit.id, anchor = hit.at, head = hit.at, dragging = true }
        return Selecting
    return Nothing

| The selection's text onto the desktop's clipboard.
CopySelection =>
    if selection = null, return Nothing
    screen = screens["$selection.id"]
    if screen = null, return Nothing
    emit SelectedText { screen = screen, selection = selection } to this get chosen
    if chosen.text = "", return Nothing
    emit Copy { text = chosen.text } to win get copied
    if copied ∈ Exception, message = "Copy: " + copied.message
    return Copied

| ── Settings and keys ──────────────────────────────────────────────────

SettingsAt { dir } =>
    emit Config { base_path = dir } to prefs get configured
    if configured ∈ Exception
        message = "settings: " + configured.message
        settings_dir = dir
    if configured ∉ Exception, settings_dir = configured.base_path
    emit LoadKeybindings to this
    emit LoadSettings to this get loaded
    return loaded

LoadKeybindings =>
    emit Exists { path = "keybindings.json" } to prefs get there
    text = null
    if there ∉ Exception and there.is_file
        emit ReadFile { path = "keybindings.json" } to prefs get read
        if read ∉ Exception, text = read.content
    emit ReadBindings { text = text } to this get table
    keytable = table
    if table.problem ≠ "", message = table.problem
    return table

LoadSettings =>
    emit Exists { path = "settings.json" } to prefs get there
    text = null
    if there ∉ Exception and there.is_file
        emit ReadFile { path = "settings.json" } to prefs get read
        if read ∉ Exception, text = read.content
    emit ReadSettings { text = text } to this get read_back
    settings = read_back.values
    if read_back.problem ≠ "", message = read_back.problem
    return read_back

| ── Drawing ────────────────────────────────────────────────────────────

State =>
    return ConsoleState { groups = groups, current = current, cols = cols, rows = rows, settings = settings, selection = selection, message = message, font_px = font_px }

| Every terminal a group shows: told its size when that changed, and read
| as far back as it is scrolled.
Screens { placed } =>
    emit Strips { state = { groups = groups, settings = settings } } to this get strips
    read = {}
    loop pane over placed
        group = groups[pane.id]
        view = group.tabs[group.active]
        wide = pane.width
        if pane.x > 0, wide = pane.width - 1
        high = pane.height
        if strips.strips, high = pane.height - 1
        size = "" + wide + "x" + high
        if sizes_told["$view.id"] ≠ size and wide > 0 and high > 0
            emit Resize { id = view.id, cols = wide, rows = high } to shells
            sizes_told = sizes_told + { "$view.id" = size }
        back = scrolls["$view.id"]
        if back = null, back = 0
        emit Screen { id = view.id, scroll = back } to shells get screen
        if screen ∉ Exception
            read = read + { "$view.id" = screen }
            | Scrolled no further than there was.
            scrolls = scrolls + { "$view.id" = screen.scrolled }
    return ScreensRead { screens = read }

Render =>
    if not running, return Skipped
    emit State to this get state
    emit Placement { state = state } to this get placement
    emit Screens { placed = placement.placed } to this get read
    screens = screens + read.screens
    | Tabs are named after what their program calls itself.
    loop gi, group over groups
        loop ti, tab over group.tabs
            seen = read.screens["$tab.id"]
            if seen ≠ null and seen.title ≠ "" and tab.label ≠ seen.title
                held = groups[gi]
                renamed = held.tabs[0, ti) + [tab + { label = seen.title }] + held.tabs(ti, length)
                groups = groups[0, gi) + [held + { tabs = renamed }] + groups(gi, length)
    emit State to this get state_now
    emit Frame { state = state_now, placement = placement, screens = read.screens } to this get frame
    places = frame.places
    emit Draw { id = wid, overlays = frame.overlays, cursor_row = frame.cursor_row, cursor_col = frame.cursor_col } to win
    emit Active { groups = groups, current = current } to this get shown
    title = "console"
    if shown.buffer ≠ null, title = shown.buffer.label + " — console"
    emit Title { id = wid, text = title } to win
    return Rendered
